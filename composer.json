{
  "name": "stevekanger/sk-php-cs-fixers",
  "description": "Custom fixers for php-cs-fixer.",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "SkPhpCsFixers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SkPhpCsFixers\\Tests\\": "tests/",
      "PhpCsFixer\\Tests\\": "vendor/friendsofphp/php-cs-fixer/tests/"
    }
  },
  "authors": [
    {
      "name": "stevekanger",
      "email": "dev.stevekanger@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.34 || ^10.5.63 || ^11.5.55",
    "friendsofphp/php-cs-fixer": "^3.95",
    "php-cs-fixer/phpunit-constraint-isidenticalstring": "^1.8"
  },
  "config": {
    "preferred-install": {
      "friendsofphp/php-cs-fixer": "source",
      "*": "dist"
    }
  },
  "scripts": {
    "test": "phpunit",
    "run:local": "php-cs-fixer fix -vvv --using-cache=no --config=local/.php-cs-fixer.php -- "
  }
}
